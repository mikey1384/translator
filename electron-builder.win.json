{
  "extends": "./electron-builder.base.json",
  "buildDependenciesFromSource": true,
  "npmRebuild": true,
  "artifactName": "Translator-${version}-win32-${arch}.${ext}",
  "win": {
    "publish": [
      {
        "provider": "generic",
        "url": "https://downloads.stage5.tools/win/latest/"
      }
    ],
    "extraResources": [
      { "from": "vendor/headless-x64", "to": "headless-x64" },
      {
        "from": "packages/agent-server/bin/translator-mcp.cmd",
        "to": "translator-mcp.cmd"
      },
      {
        "from": "packages/agent-server/bin/translator-owner-supervisor.exe",
        "to": "translator-owner-supervisor.exe"
      }
    ],
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "signtoolOptions": {
      "certificateSubjectName": "Stage5 Tools LLC",
      "certificateSha1": "49C41CB6AF15751A69DAAE91E9A8FECD449B576D",
      "signingHashAlgorithms": ["sha256"],
      "timeStampServer": "http://timestamp.digicert.com"
    },
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov", "webm", "avi"],
        "name": "Video File",
        "description": "Video file opened with Translator",
        "icon": "build/file_icon.ico"
      }
    ]
  },
  "forceCodeSigning": true,
  "nsis": {
    "include": "installer-override.nsh",
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "oneClick": false,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": false,
    "menuCategory": "Video Tools",
    "deleteAppDataOnUninstall": false,
    "differentialPackage": false,
    "artifactName": "${productName} Setup ${version}.${ext}",
    "uninstallDisplayName": "${productName}",
    "displayLanguageSelector": false
  }
}
