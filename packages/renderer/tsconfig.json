{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "lib": ["dom", "es2022"],
    "types": ["electron"],
    "baseUrl": ".",
    "paths": {
      "@ipc/*": ["./ipc/*"],
      "@shared/*": ["../shared/*"],
      "@shared-types/*": ["../shared/types/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../shared/**/*.ts", "../shared/**/*.d.ts"]
}
