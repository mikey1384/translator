{
  "appId": "tools.stage5.translator",
  "productName": "Translator",
  "artifactName": "Translator-${version}-darwin-${arch}.${ext}",
  "icon": "assets/icon",

  "publish": [
    {
      "provider": "github",
      "owner": "mikey1384",
      "repo": "translator"
    }
  ],

  "directories": {
    "app": ".",
    "output": "dist"
  },

  "asar": true,
  "asarUnpack": [
    "node_modules/webrtcvad/**",
    "node_modules/ffmpeg-ffprobe-static/**",
    "node_modules/onnxruntime-node/**",
    "node_modules/youtube-dl-exec/**",
    "render-host.html",
    "render-host-script.js"
  ],

  "buildDependenciesFromSource": false,

  "copyright": "Copyright © 2025 Mikey Lee",

  "protocols": [
    {
      "name": "Stage5 Translator Checkout",
      "schemes": ["stage5-translator"]
    }
  ],

  "afterPack": "scripts/sign-chromium.cjs",

  "extraResources": [
    {
      "from": "vendor/headless-${arch}",
      "to": "headless-${arch}"
    },
    { "from": "vendor/vision", "to": "vision-models" },
    {
      "from": "packages/agent-server/src/packaged-mcp.mjs",
      "to": "packaged-mcp.mjs"
    },
    {
      "from": "packages/agent-server/src/transport-bound-lifecycle.mjs",
      "to": "transport-bound-lifecycle.mjs"
    },
    {
      "from": "packages/agent-server/src/native-owner-monitor.mjs",
      "to": "native-owner-monitor.mjs"
    },
    {
      "from": "packages/agent-server/src/packaged-agent-protocol.mjs",
      "to": "packaged-agent-protocol.mjs"
    },
    {
      "from": "packages/agent-server/src/stream-codecs.mjs",
      "to": "stream-codecs.mjs"
    },
    {
      "from": "packages/agent-server/src/packaged-tool-map.mjs",
      "to": "packaged-tool-map.mjs"
    },
    {
      "from": "packages/agent-server/src/tool-schema-validator.mjs",
      "to": "tool-schema-validator.mjs"
    },
    {
      "from": "packages/agent-server/src/packaged-socket-path.mjs",
      "to": "packaged-socket-path.mjs"
    },
    {
      "from": "packages/agent-server/bin/translator-mcp",
      "to": "translator-mcp"
    },
    {
      "from": "packages/agent-server/bin/translator-mcp.cmd",
      "to": "translator-mcp.cmd"
    },
    {
      "from": "packages/agent-server/bin/translator-owner-supervisor",
      "to": "translator-owner-supervisor"
    }
  ],

  "files": [
    "packages/main/dist/**/*",
    "packages/main/boot.mjs",
    "packages/main/startup-health.mjs",
    "packages/renderer/dist/**/*",
    "packages/renderer/locales/**/*",
    "index.js",
    "package.json",
    "packages/main/package.json",
    "render-host.html",
    "render-host-script.js",
    "node_modules/**/*"
  ],

  "mac": {
    "category": "public.app-category.video",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "entitlements.mac.plist",
    "identity": "JONG UK LEE (26WR9SJHBZ)",
    "notarize": true,
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov", "webm", "avi"],
        "name": "Video File",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  },

  "win": {
    "target": [{ "target": "nsis", "arch": ["x64", "ia32"] }],
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov", "webm", "avi"],
        "name": "Video File",
        "description": "Video file opened with Translator",
        "icon": "build/file_icon.ico"
      }
    ]
  },

  "nsis": { "perMachine": true }
}
